# ==============================================================================
# TEMPLATE: Variables de Entorno del Backend
# Copiar este archivo como `.env` en `backend/.env`
# ==============================================================================

# Entorno de ejecución (development | production)
APP_ENV=development
APP_PORT=8000

# Credenciales de API Generativa (Analista Crítico JSON + OCR Multimodal Gemini Flash)
GEMINI_API_KEY=your_google_genai_api_key_here
GEMINI_ANALYST_MODEL=gemini-2.5-flash

# Configuración del Juez Entrenado (BETO fine-tuned en Hugging Face Hub o ruta local)
BETO_MODEL_ID=dccuchile/bert-base-spanish-wwm-cased
HF_API_TOKEN=your_optional_huggingface_token_here

# Modelo spaCy para Anonimizador NER y Contador Estructural
SPACY_MODEL_NAME=es_core_news_lg

# Base de datos / Caché de análisis para ahorrar tokens
DATABASE_URL=sqlite+aiosqlite:///./bias_detector_cache.db
